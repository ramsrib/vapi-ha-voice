# Copy to secrets.yaml (gitignored) and fill in.
# Two networks: wifi1 is tried first (higher priority), wifi2 is the fallback.
wifi1_ssid: "venue-or-primary-ssid"
wifi1_password: "..."
wifi2_ssid: "home-ssid"
wifi2_password: "..."

# From https://dashboard.vapi.ai — a private key, not a public one: this
# firmware calls POST /call, which a public key cannot do.
vapi_api_key: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Optional. Omit to use the transient assistant defined in vapi-voice.yaml.
vapi_assistant_id: ""
